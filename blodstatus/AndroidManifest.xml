<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.bullhead.blodstatus">

    <application android:label="@string/title">
        <!-- Read-only row in Settings > About phone -->
        <activity
            android:name=".BlodStatusActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.BlodStatus">
            <intent-filter>
                <action android:name="com.android.settings.action.EXTRA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.my_device_info" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/title" />
            <meta-data
                android:name="com.android.settings.summary_uri"
                android:value="content://org.lineageos.bullhead.blodstatus/getSummary" />
        </activity>

        <provider
            android:name=".BlodStatusProvider"
            android:authorities="org.lineageos.bullhead.blodstatus"
            android:exported="true" />
    </application>
</manifest>
