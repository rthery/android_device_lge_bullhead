cc_library_shared {
    name: "libbullhead_ril_audio",
    srcs: ["ril_audio.cpp"],
    shared_libs: ["android.hardware.audio@6.0", "libhidlbase", "libutils", "liblog"],
    vendor: true,
    compile_multilib: "64",
}

cc_library_shared {
    srcs: ["libaudioclient_shim.cpp"],
    name: "libbullhead_audiosystem_shim",
    shared_libs: ["libaudioclient"],
}

cc_library {
    name: "libshim_dpmframework",
    srcs: [
        "strdup16to8.cpp",
        "strdup8to16.cpp",
    ],
    vendor: true,
}

cc_library_shared {
    srcs: ["sensor.cpp"],
    shared_libs: [
	"libsensor",
	"libhardware",
	"libutils"
    ],
    name: "libshim_sensor",
}

cc_library_shared {
    srcs: ["libprotobuf_shim.cpp"],
    shared_libs: ["liblog"],
    name: "libprotobuf_shim",
    vendor: true,
}

cc_library_shared {
    name: "libbullhead_peripheral_binder",
    srcs: ["peripheral_binder.cpp"],
    shared_libs: ["libbinder", "libutils"],
    vendor: true,
    compile_multilib: "64",
}

cc_library_shared {
    name: "libbullhead_ims_surface",
    srcs: ["ims_surface.cpp"],
    shared_libs: ["libgui", "libutils", "libbinder"],
    vendor: true,
    compile_multilib: "64",
}
