cc_prebuilt_library_shared {
    name: "libprotobuf-cpp-lite-v29",
    target: {
        android_arm: {
            srcs: ["arm/libprotobuf-cpp-lite.so"],
        },
        android_arm64: {
            srcs: ["arm64/libprotobuf-cpp-lite.so"],
        },
    },
    compile_multilib: "both",
    check_elf_files: false,
    strip: {
        none: true,
    },
    soc_specific: true,
}

cc_prebuilt_library_shared {
    name: "libcutils-v29",
    target: {
        android_arm64: {
            srcs: ["arm64/libcutils.so"],
        },
    },
    compile_multilib: "64",
    check_elf_files: false,
    strip: {
        none: true,
    },
}
