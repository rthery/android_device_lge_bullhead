type bullhead-sh, domain;
type bullhead-sh_exec, exec_type, file_type, vendor_file_type;

# Started by init
init_daemon_domain(bullhead-sh)

# Access to /data/misc/radio/*
allow bullhead-sh radio_data_file:file create_file_perms;
allow bullhead-sh radio_data_file:dir create_dir_perms;

# The parent directory keeps the Android 13 core label. Only directory entry
# operations are needed there; the copied modem tree has its own device label.
allow bullhead-sh radio_core_data_file:dir { add_name create getattr open read remove_name search write };
allow bullhead-sh bullhead_modem_config_data_file:dir create_dir_perms;
allow bullhead-sh bullhead_modem_config_data_file:file create_file_perms;

# The script recreates modem_config on every boot; its contents inherit this label.
type_transition bullhead-sh radio_core_data_file:dir bullhead_modem_config_data_file "modem_config";
type_transition bullhead-sh radio_core_data_file:file bullhead_modem_config_data_file "copy_complete";

# Chwon /data/misc/radio/modem_config
allow bullhead-sh self:capability chown;

# Copy /firmware/image/modem_pr/mcfg/configs/ to /data/misc/radio/*
allow bullhead-sh firmware_file:file r_file_perms;
allow bullhead-sh firmware_file:dir r_dir_perms;

allow bullhead-sh shell_exec:file r_file_perms;

# execute toybox/toolbox
allow bullhead-sh toolbox_exec:file rx_file_perms;
