binder_call(rild, audioserver)
binder_call(rild, mediaserver)
binder_use(rild)
binder_service(rild)
vndbinder_use(rild)

# Grant access to Qualcomm MSM Interface (QMI) radio sockets to RILD
qmux_socket(rild)

# whitelist qualcomm specific ioctls
allow rild self:socket ioctl;
allowxperm rild self:socket ioctl msm_sock_ipc_ioctls;
allowxperm rild self:udp_socket ioctl priv_sock_ioctls;

allow rild persist_file:dir search;

# rild needs to parse through /proc to obtain pid of netmgrd
r_dir_file(rild, netmgrd)
# b/18352920 suppress denials until the procfs lookup is removed
dontaudit rild domain:dir r_dir_perms;

allow rild audioserver_service:service_manager find;
allow rild mediaserver_service:service_manager find;
allow rild per_mgr_service:service_manager find;

allow rild time_daemon:unix_stream_socket connectto;

# rild reads qcril.db linked to /system/etc/qcril.db
allow rild radio_data_file:lnk_file read;

# Android 13 labels /data/misc/radio as radio_core_data_file. rild needs the
# directory operations for qcril.db's SQLite journal, and access only to the
# explicitly labeled database and SIM identity files below.
allow rild radio_core_data_file:dir rw_dir_perms;
allow rild bullhead_radio_db_file:file { create getattr ioctl lock open read setattr unlink write };
allow rild bullhead_radio_id_file:file rw_file_perms;

# rild reads the copied modem configuration tree.
allow rild bullhead_modem_config_data_file:dir r_dir_perms;
allow rild bullhead_modem_config_data_file:file r_file_perms;

# Label newly created SQLite database and sidecar files at creation time.
type_transition init radio_core_data_file:file bullhead_radio_db_file "qcril.db";
type_transition rild radio_core_data_file:file bullhead_radio_db_file "qcril.db-journal";
type_transition rild radio_core_data_file:file bullhead_radio_db_file "qcril.db-wal";
type_transition rild radio_core_data_file:file bullhead_radio_db_file "qcril.db-shm";
type_transition rild radio_core_data_file:file bullhead_radio_id_file "iccid_0";
type_transition rild radio_core_data_file:file bullhead_radio_id_file "dummy_file";

# allow rild to access radio data file
allow rild radio_data_file:dir rw_dir_perms;
allow rild radio_data_file:file create_file_perms;

userdebug_or_eng(`
  allow rild ssr_device:chr_file { open read };

  allow rild sysfs_msm_subsys:dir { open search read };
  allow rild sysfs_msm_subsys:lnk_file { read open };
  allow rild sysfs_msm_subsys:dir r_dir_perms;
  allow rild sysfs_msm_subsys:lnk_file read;
')

allow rild diag_device:chr_file rw_file_perms;

# allow rild to use qualcomm's socket ipc ioctls
allow rild self:socket ioctl;
allowxperm rild self:socket ioctl msm_sock_ipc_ioctls;
