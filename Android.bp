soong_namespace {
}

install_symlink {
    name: "gps.conf_symlink",
    installed_location: "etc/gps.conf",
    symlink_target: "/vendor/etc/gps.conf",
}

install_symlink {
    name: "sound_trigger_mixer_paths.xml_symlink",
    installed_location: "etc/sound_trigger_mixer_paths.xml",
    symlink_target: "/vendor/etc/sound_trigger_mixer_paths.xml",
}

install_symlink {
    name: "sound_trigger_platform_info.xml_symlink",
    installed_location: "etc/sound_trigger_platform_info.xml",
    symlink_target: "/vendor/etc/sound_trigger_platform_info.xml",
}

// netmgrd runs bare iptables, ip6tables and ndc; route them through the netutils wrapper
install_symlink {
    name: "netmgrd_iptables_symlink",
    installed_location: "bin/netutils/iptables",
    symlink_target: "/system/bin/netutils-wrapper-1.0",
    vendor: true,
}

install_symlink {
    name: "netmgrd_ip6tables_symlink",
    installed_location: "bin/netutils/ip6tables",
    symlink_target: "/system/bin/netutils-wrapper-1.0",
    vendor: true,
}

sh_binary {
    name: "netmgrd_ndc",
    src: "rootdir/bin/netmgrd-ndc.sh",
    filename: "ndc",
    sub_dir: "netutils",
    vendor: true,
}
